{
  "name": "@local/dsh-vpn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Subscription-driven outbound proxy for DeepSeek Harness: a local mihomo core, a settings page, and Harness-scoped network routing.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@pkgship/mihomo": "1.19.33",
    "yaml": "^2.8.1"
  },
  "license": "MIT"
}
